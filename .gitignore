# Retail game data. Never commit these; every user supplies their own copy.
/disc/
/baserom/
/src/text/text_bank.json

# Generated by `make split` from the baserom. Only the two hand-kept CRT0
# fragments are source.
/asm/*
!/asm/nonmatchings/
/asm/nonmatchings/*
!/asm/nonmatchings/crt0/
/asm/nonmatchings/crt0/*
!/asm/nonmatchings/crt0/start.s
!/asm/nonmatchings/crt0/stup1.s

# Build output and splat byproducts.
/build/
/undefined_funcs_auto.txt
/undefined_syms_auto.txt

# Compiled or packaged binary artifacts.
*.bin
*.cue
*.iso
*.chd
*.elf
*.o
*.obj
*.map
*.d
*.exe
*.EXE

# Python environments and caches.
__pycache__/
*.py[cod]
.venv/
venv/

# Editor and operating-system metadata.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Agent skill runtime dependencies and local state.
node_modules/
.local/
